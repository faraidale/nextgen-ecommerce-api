                    "schema": {
                        "type": "string"
                    }
                }
            ],
            "get": {
                "summary": "Get an order by ID",
                "description": "Returns a single order by ID.",
                "responses": {
                    "200": {
                        "description": "Order retrieved successfully.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Order"
                                }
                            }
                        }
                    }
                },
                "tags": [
                    "Orders"
                ]
            },
            "put": {
                "summary": "Update an order",
