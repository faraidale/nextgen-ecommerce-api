    },
    "components": {
        "schemas": {
            "ReviewInput": {
                "type": "object",
                "required": [
                    "productId",
                    "userId",
                    "rating",
                    "title",
                    "comment",
                    "reviewDate"
                ],
                "properties": {
                    "productId": {
                        "type": "string"
                    },
                    "userId": {
                        "type": "string"
                    },
                    "rating": {
                        "type": "number"
                    },
                    "title": {
                        "type": "string"
                    },
                    "comment": {
                        "type": "string"
                    },
                    "reviewDate": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "Review": {
                "allOf": [
                    {
                        "$ref": "#/components/schemas/ReviewInput"
                    },
                    {
                        "type": "object",
                        "properties": {
                            "_id": {
                                "type": "string",
                                "description": "MongoDB review ID."
                            }
                        }
                    }
                ]
            },
            "OrderInput": {
                "type": "object",
                "required": [
                    "orderId",
                    "userId",
                    "productId",
                    "quantity",
                    "orderStatus",
                    "orderDate"
                ],
                "properties": {
                    "orderId": {
                        "type": "string"
                    },
                    "userId": {
                        "type": "string"
                    },
                    "productId": {
                        "type": "string"
                    },
                    "quantity": {
                        "type": "integer"
                    },
                    "orderStatus": {
                        "type": "string"
                    },
                    "orderDate": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "Order": {
                "allOf": [
                    {
                        "$ref": "#/components/schemas/OrderInput"
                    },
                    {
                        "type": "object",
                        "properties": {
                            "_id": {
                                "type": "string",
                                "description": "MongoDB order ID."
                            }
                        }
                    }
                ]
            },
            "ProductInput": {
                "type": "object",
                "required": [
                    "productName",
                    "description",
                    "price",
                    "category",
                    "stockQuantity",
                    "manufacturer",
                    "dateAdded",
                    "isActive"
                ],
                "properties": {
                    "productName": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "price": {
                        "type": "number",
                        "format": "double"
                    },
                    "category": {
                        "type": "string"
                    },
                    "stockQuantity": {
                        "type": "integer"
                    },
                    "manufacturer": {
                        "type": "string"
                    },
                    "dateAdded": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "isActive": {
                        "type": "boolean"
                    }
                }
            },
            "Product": {
                "allOf": [
                    {
                        "$ref": "#/components/schemas/ProductInput"
                    },
                    {
                        "type": "object",
                        "properties": {
                            "_id": {
                                "type": "string",
                                "description": "MongoDB product ID."
                            }
                        }
                    }
                ]
            },
            "UserInput": {
                "type": "object",
                "required": [
                    "oauthId",
                    "displayName",
                    "email",
                    "joinDate"
                ],
                "properties": {
                    "oauthId": {
                        "type": "string"
                    },
                    "displayName": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string",
                        "format": "email"
                    },
                    "joinDate": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "User": {
                "allOf": [
                    {
                        "$ref": "#/components/schemas/UserInput"
                    },
                    {
                        "type": "object",
                        "properties": {
                            "_id": {
                                "type": "string",
                                "description": "MongoDB user ID."
                            }
                        }
                    }
                ]
            }
        },
        "securitySchemes": {
            "githubAuth": {
                "type": "apiKey",
                "in": "cookie",
                "name": "connect.sid",
                "description": "GitHub OAuth login session cookie. Authenticate through GET /login first."
            }
        }
    }
}
